# OpenAI-compatible Chat API。Base URL 通常需要包含 /v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false

# DashScope OpenAI-compatible Embedding API；请填写对应 API Key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=20

CHROMA_PATH=./data/chroma
# 使用新 Collection，避免与旧 BGE-M3 向量混用
CHROMA_COLLECTION=travel_knowledge_online
RETRIEVAL_TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
